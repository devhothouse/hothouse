# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client (regenerated by prisma generate / db push)
/src/generated/prisma

# =========================================================
# PRERELEASE HYGIENE — private workspace & per-machine data.
# Everything in here lives ONLY on disk (agents can read it)
# and in the private archive repo — it never ships with git.
# =========================================================

# Private workspace: roadmap, devlog, archived docs, private data,
# one-off DB tools. Referenced by agents; never committed.
/_workspace/

# Local SQLite databases — created automatically on first launch
# (prisma db push + default seeding). User-specific; never commit.
/prisma/dev.db
/dev.db
*.db-journal

# Runtime user uploads (avatars, generated images)
/public/uploads/*

# Machine-local launcher preferences & shortcuts
/launch-settings.json
/*.lnk

# Agent tooling configs (local sessions only)
/.claude/
/.windsurf/
/.agents/
/CLAUDE.md
/skills-lock.json
